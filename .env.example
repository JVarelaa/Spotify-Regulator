# Copia este fichero a .env (chmod 600 .env).
# Client ID de tu app en https://developer.spotify.com/dashboard
# Con PKCE no hace falta el client secret.
SPOTIFY_CLIENT_ID=

# Contraseña de aplicación del SMTP (en Gmail: Cuenta de Google > Seguridad >
# Contraseñas de aplicaciones; requiere verificación en dos pasos).
# NO es la contraseña de tu cuenta. Solo hace falta si config.yaml tiene sección email.
SMTP_PASSWORD=
